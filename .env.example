# ──────────────────────────────────────────────────────────────────────────────
# PersonaStorm environment.
#
# PersonaStorm is a Vercel FULL-STACK Next.js app. Production needs only:
#     Vercel  +  Supabase
# There is NO separate backend to deploy and NO backend URL to configure. The
# API runs as Next.js Route Handlers under apps/web/app/api/* on the same
# origin as the frontend. The variables below marked "server-side" are read on
# the server only (never NEXT_PUBLIC_, never in the browser bundle).
#
# The old apps/api FastAPI service remains for local/dev/reference only — it is
# NOT part of the production deployment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Frontend (browser) — PUBLIC. Safe to expose. Anon key cannot bypass RLS. ──
# Required in production for login/signup. Inlined into the browser bundle.
# NEXT_PUBLIC_SUPABASE_URL must be ONLY the project origin — no path segments
# (no /rest/v1, /auth/v1, /storage/v1): https://<project-ref>.supabase.co
# Validated + normalized at runtime as defense-in-depth: a pathed value (e.g.
# ending in /rest/v1) is stripped back to the bare origin automatically and a
# warning is logged, on top of the existing CI check in deploy.yml.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL used to build Supabase Auth redirect targets
# (emailRedirectTo / redirectTo for signup confirmation, magic links, and
# password reset). PUBLIC — safe to expose; inlined into the browser bundle.
# If unset, the app falls back to NEXT_PUBLIC_VERCEL_URL, then the runtime
# window.location.origin, then http://localhost:3000 (LOCAL DEV ONLY).
#   Local dev:   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   Production:  NEXT_PUBLIC_SITE_URL=https://personastorm.nguyenhaan.id.vn
# NEVER use http://localhost:3000 in production — confirmation emails would send
# users back to localhost. The Actions deploy validates this on production.
NEXT_PUBLIC_SITE_URL=

# ── Vercel server-side (Route Handlers) — read at request time on the server ──
# SUPABASE_URL: the project URL used by server code. If unset, the server falls
# back to NEXT_PUBLIC_SUPABASE_URL (the project URL is not a secret).
SUPABASE_URL=
# SECRET. Bypasses Row Level Security — server-only. NEVER prefix with
# NEXT_PUBLIC_ and NEVER expose to the browser. Owns every wallet mutation.
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL. SECRET. HS256 secret used to verify Supabase access tokens offline
# (Supabase dashboard -> Project Settings -> API -> JWT Secret). Token
# validation is algorithm-aware: this secret is only ever used for tokens that
# declare HS256. If it is unset, OR the project uses the modern asymmetric JWT
# signing keys (ES256/RS256 — the default for new Supabase projects), tokens
# are validated remotely against GoTrue (/auth/v1/user) instead. A wrong HS256
# secret on an asymmetric-key project no longer breaks auth (it self-heals via
# the GoTrue fallback), but you should still fix it if you notice it's wrong.
SUPABASE_JWT_SECRET=
# Optional server-side anon key (used as the apikey header for GoTrue token
# validation when SUPABASE_JWT_SECRET is unset). Falls back to
# NEXT_PUBLIC_SUPABASE_ANON_KEY, then the service role key.
SUPABASE_ANON_KEY=

# API_ENV=prod hardens auth: it refuses unverified tokens when SUPABASE_JWT_SECRET
# is unset. Set to prod in production.
# API_ENV=dev

# Starter credits granted to a new user by the in-memory dev gateway only. In
# production the handle_new_user() SQL trigger is authoritative (also 100).
STARTER_CREDITS=100

# ── Inference providers (server-side) ────────────────────────────────────────
# Reaction engine for the persona swarm: mock | nvidia
INFERENCE_PROVIDER=mock
# Report/analyst model: mock (local deterministic builder) | nvidia (GLM-5.2)
ANALYST_PROVIDER=mock

# NVIDIA NIM (OpenAI-compatible). SECRET — server-side only, never NEXT_PUBLIC_.
# Only needed if INFERENCE_PROVIDER=nvidia or ANALYST_PROVIDER=nvidia. mock mode
# works with no key. NOTE: the hosted endpoint is rate-limited; running the full
# 1,000-persona swarm through it synchronously may exceed a serverless function's
# time limit — mock is the recommended default on Vercel (see docs/deployment.md).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_MAX_TOKENS=2048
ANALYST_MAX_TOKENS=4096

# ── Nemotron-orchestrated Fireworks worker swarm (apps/web, server-side) ─────
# OPT-IN production architecture: Nemotron (NVIDIA) is the orchestrator "main
# brain" (plan → delegate → review → synthesize); Fireworks DeepSeek-V4-Flash
# runs the cheap physical workers. Enable per-run via the admin panel
# (orchestration_enabled). Default off — the classic engine path is unchanged.
#
# HARD CAP: at most 10 physical Fireworks calls per storm, enforced in code
# (MAX_PHYSICAL_SWARM_WORKERS). Extra demand becomes VIRTUAL agents inside a
# shard prompt — never more real API calls. No env/DB/admin value raises it.
#
# SECRETS — server-side only, never NEXT_PUBLIC_. Exposed to the admin UI only
# as booleans (fireworks_api_key_configured / nvidia_api_key_configured).
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_DEEPSEEK_MODEL=accounts/fireworks/models/deepseek-v4-flash
# Orchestrator ("main brain") model — reuses NVIDIA_API_KEY / NVIDIA_BASE_URL.
NVIDIA_ORCHESTRATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── apps/api (Python reference backend) — live nemotron reasoning inference ──
# These knobs are read by the FastAPI service (apps/api) only; the Vercel web
# app ignores them. The hosted swarm is for correctness testing at small
# persona_count (create a storm with persona_count=50), NOT full 1,000-persona
# production runs — see docs/inference-roadmap.md.
#   NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#   NVIDIA_STRUCTURED_OUTPUT=json_object   # guided_json | json_object | none;
#                                          # 'none' matches the verified call shape
#   NVIDIA_ENABLE_THINKING=true            # send chat_template_kwargs.enable_thinking
#   NVIDIA_REASONING_BUDGET=4096           # thinking-token cap
#   NVIDIA_MAX_TOKENS=8192                 # MUST exceed the reasoning budget
#   ANALYST_MAX_TOKENS=8192                # MUST exceed the reasoning budget
#   NVIDIA_MAX_RETRIES=3                   # 429/5xx backoff attempts
#   SWARM_MAX_DROP_FRACTION=0.10           # fail the storm if more drop after retries
#   STORM_MAX_CONCURRENCY=4                # gentle on the rate-limited endpoint

# ── Reproducibility & stream pacing (server-side) ────────────────────────────
PERSONA_SEED=1337
# The SSE stream replays a completed run's stored reactions to animate the live
# grid. These pace that replay (data is precomputed, so this is cosmetic only).
STREAM_BATCH_SIZE=25
STREAM_BATCH_INTERVAL_MS=45

# ── Admin bootstrap (used only by scripts/create_admin_user.py) ──────────────
# Run once after migrations to create the first admin. ADMIN_PASSWORD is a
# SECRET and must never be synced into Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=PersonaStorm Admin

# ──────────────────────────────────────────────────────────────────────────────
# DEPRECATED / NO LONGER REQUIRED — do not set these. PersonaStorm no longer
# proxies to an external backend, so there is no backend URL to configure:
#   BACKEND_API_BASE=          # removed — API is same-origin Route Handlers
#   NEXT_PUBLIC_API_BASE=      # removed — never had a public API base
# The old apps/api FastAPI service still reads CORS_ORIGINS etc. for local dev,
# but none of that is needed for the Vercel production deployment.
# ──────────────────────────────────────────────────────────────────────────────
