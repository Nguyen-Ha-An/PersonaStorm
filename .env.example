# ──────────────────────────────────────────────────────────────────────────────
# PersonaStorm environment. Copy to .env and adjust. Everything has safe
# defaults — the app runs with an empty .env in mock mode.
#
# The app runs fully locally with INFERENCE_PROVIDER=mock and
# ANALYST_PROVIDER=mock — no key needed. If ANALYST_PROVIDER=nvidia and
# NVIDIA_API_KEY is missing, the analyst falls back to the local report
# builder with a clear log (the storm never fails because of the analyst).
# ──────────────────────────────────────────────────────────────────────────────

# Reaction engine for the 1,000-persona swarm: mock | nvidia | vllm
INFERENCE_PROVIDER=mock

# Report/analyst model: mock (local deterministic builder) | nvidia (GLM-5.2)
ANALYST_PROVIDER=mock

# ── NVIDIA Build / NVIDIA NIM (OpenAI-compatible) ─────────────────────────────
# Used as the `nvidia` reaction provider AND/OR the `nvidia` analyst. Get an
# 'nvapi-' key at https://build.nvidia.com. Point NVIDIA_BASE_URL at a
# self-hosted NIM container's /v1 endpoint instead to run on your own GPU
# (key usually not needed in that case).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
# Strict JSON via NIM's nvext.guided_json (recommended for the reaction
# swarm). Set false to use response_format=json_object instead, if a
# model/endpoint rejects the NIM extension.
NVIDIA_USE_GUIDED_JSON=true
# Per-persona reaction budget. GLM-5.2 is a reasoning model; reasoning
# tokens count against this budget too.
NVIDIA_MAX_TOKENS=2048
# Larger budget for the analyst report narration (executive summary,
# recommendations, objection labels, kill quote) — one call per storm.
ANALYST_MAX_TOKENS=4096

# ── vLLM (future AMD MI300X / ROCm high-throughput swarm) ────────────────────
# Example server launch — see docs/inference-roadmap.md:
#   vllm serve google/gemma-3-27b-it --port 8001
# A fine-tuned persona model (e.g. a LoRA adapter named
# `gemma-persona-reaction`) slots in here as VLLM_MODEL once trained.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=google/gemma-3-27b-it

# ── Swarm pacing (mock provider only; real providers pace themselves) ─────────
STORM_BATCH_SIZE=25
STORM_BATCH_INTERVAL_MS=350

# ── Reproducibility ───────────────────────────────────────────────────────────
PERSONA_SEED=1337

# ── Server (FastAPI backend) ────────────────────────────────────────────────────
# Browser origins allowed to call the API directly. With the Next.js
# BACKEND_API_BASE proxy in front (see the Frontend section below), the
# official web app calls the backend server-to-server — not from the browser —
# so CORS no longer applies to it. This still matters if you call the API
# directly from a browser (curl/Postman don't need it either), e.g. a future
# separate client, local development against the API without the proxy, or the
# API's own /docs page, e.g.
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://personastorm.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for dynamic origins such as Vercel preview deployments whose
# subdomain changes per branch/commit. Leave unset if you don't use previews.
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Supabase (auth + database) — BACKEND, server-side only ───────────────────
# The SaaS layer (login, wallets, pricing, admin) needs Supabase. When these
# are UNSET the API falls back to an in-memory gateway + dev auth so it still
# boots and the test suite runs without a live Supabase — but real login,
# billing and persistence require these to be set in production.
#
# Find these in the Supabase dashboard: Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET. Bypasses Row Level Security — server-side only, NEVER in frontend env.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. HS256 secret used to verify access tokens (Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=
# Starter credits granted to a new user by the in-memory dev gateway. In
# production the handle_new_user() SQL trigger is authoritative (also 100).
STARTER_CREDITS=100

# API_ENV=prod hardens auth: it refuses to accept tokens if SUPABASE_JWT_SECRET
# is unset (dev accepts unverified tokens for local convenience). Set to prod
# when deploying the backend.
# API_ENV=dev

# ── Admin bootstrap (used only by scripts/create_admin_user.py) ──────────────
# Run once after migrations to create the first admin:  python scripts/create_admin_user.py
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=PersonaStorm Admin

# ── Frontend (apps/web/.env.local for local dev; Vercel env for production) ──────
#
# The browser never talks to the FastAPI backend directly — it calls this
# app's own same-origin proxy route (/api/backend/..., see
# apps/web/app/api/backend/[...path]/route.ts), which forwards server-side to
# BACKEND_API_BASE below. This means the browser bundle never needs to know
# the backend's real address, and login/signup/dashboard (Supabase-only) keep
# working even before the backend is deployed.
#
# NOTE: an older version of this app read NEXT_PUBLIC_API_BASE directly in the
# browser. That variable is gone — replace it with BACKEND_API_BASE (below),
# which is a plain server-side variable, NOT prefixed with NEXT_PUBLIC_.

# BACKEND_API_BASE — SERVER-SIDE ONLY. Do not prefix with NEXT_PUBLIC_; doing so
# would bake the backend's address into the public browser bundle.
# LOCAL DEV: leave unset and the proxy falls back to http://localhost:8000
# (matching `uvicorn app.main:app --reload --port 8000` in apps/api).
# PRODUCTION: REQUIRED. Point it at your deployed FastAPI backend URL. If it is
# missing in production, the app still loads (Supabase login/dashboard work) —
# only storm/billing/admin calls return a clear 503 JSON error until it's set.
#   BACKEND_API_BASE=https://your-deployed-fastapi-backend.com
# BACKEND_API_BASE=http://localhost:8000

# Supabase browser client (anon key only — NEVER the service role key). Safe to
# expose: it identifies the project but cannot bypass Row Level Security.
# Required in production for login/signup to work.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
