# ──────────────────────────────────────────────────────────────────────────────
# PersonaStorm environment. Copy to .env and adjust. Everything has safe
# defaults — the app runs with an empty .env in mock mode.
# ──────────────────────────────────────────────────────────────────────────────

# Which reaction engine drives the swarm: mock | fireworks | vllm | nim
INFERENCE_PROVIDER=mock

# ── Fireworks (hosted Gemma — analyst agent and/or swarm) ─────────────────────
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/gemma-3-27b-it

# ── vLLM on AMD MI300X / ROCm (OpenAI-compatible server) ──────────────────────
# Example server launch — see docs/inference-roadmap.md:
#   vllm serve google/gemma-3-27b-it --port 8001
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=google/gemma-3-27b-it

# ── NVIDIA NIM (OpenAI-compatible: hosted build.nvidia.com or self-hosted) ────
# Hosted: get an 'nvapi-' key at https://build.nvidia.com and set NIM_API_KEY.
# Self-hosted NIM container: point NIM_BASE_URL at http://<host>:8000/v1 and
# NIM_API_KEY is usually not needed.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=z-ai/glm-5.2
# Strict JSON via NIM's nvext.guided_json (recommended). Set false to use
# response_format=json_object instead, if a model/endpoint rejects nvext.
NIM_USE_GUIDED_JSON=true
# GLM-5.2 is a reasoning model; reasoning tokens count against this budget.
NIM_MAX_TOKENS=2048

# ── Swarm pacing (mock provider only; real providers pace themselves) ─────────
STORM_BATCH_SIZE=25
STORM_BATCH_INTERVAL_MS=350

# ── Reproducibility ───────────────────────────────────────────────────────────
PERSONA_SEED=1337

# ── Server ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (apps/web/.env.local) ─────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE=http://localhost:8000
