# ──────────────────────────────────────────────────────────────────────────────
# PersonaStorm environment. Copy to .env and adjust. Everything has safe
# defaults — the app runs with an empty .env in mock mode.
#
# The app runs fully locally with INFERENCE_PROVIDER=mock and
# ANALYST_PROVIDER=mock — no key needed. If ANALYST_PROVIDER=nvidia and
# NVIDIA_API_KEY is missing, the analyst falls back to the local report
# builder with a clear log (the storm never fails because of the analyst).
# ──────────────────────────────────────────────────────────────────────────────

# Reaction engine for the 1,000-persona swarm: mock | nvidia | vllm
INFERENCE_PROVIDER=mock

# Report/analyst model: mock (local deterministic builder) | nvidia (GLM-5.2)
ANALYST_PROVIDER=mock

# ── NVIDIA Build / NVIDIA NIM (OpenAI-compatible) ─────────────────────────────
# Used as the `nvidia` reaction provider AND/OR the `nvidia` analyst. Get an
# 'nvapi-' key at https://build.nvidia.com. Point NVIDIA_BASE_URL at a
# self-hosted NIM container's /v1 endpoint instead to run on your own GPU
# (key usually not needed in that case).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
# Strict JSON via NIM's nvext.guided_json (recommended for the reaction
# swarm). Set false to use response_format=json_object instead, if a
# model/endpoint rejects the NIM extension.
NVIDIA_USE_GUIDED_JSON=true
# Per-persona reaction budget. GLM-5.2 is a reasoning model; reasoning
# tokens count against this budget too.
NVIDIA_MAX_TOKENS=2048
# Larger budget for the analyst report narration (executive summary,
# recommendations, objection labels, kill quote) — one call per storm.
ANALYST_MAX_TOKENS=4096

# ── vLLM (future AMD MI300X / ROCm high-throughput swarm) ────────────────────
# Example server launch — see docs/inference-roadmap.md:
#   vllm serve google/gemma-3-27b-it --port 8001
# A fine-tuned persona model (e.g. a LoRA adapter named
# `gemma-persona-reaction`) slots in here as VLLM_MODEL once trained.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=google/gemma-3-27b-it

# ── Swarm pacing (mock provider only; real providers pace themselves) ─────────
STORM_BATCH_SIZE=25
STORM_BATCH_INTERVAL_MS=350

# ── Reproducibility ───────────────────────────────────────────────────────────
PERSONA_SEED=1337

# ── Server ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (apps/web/.env.local) ─────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE=http://localhost:8000
